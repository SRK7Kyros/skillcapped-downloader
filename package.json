{
  "name": "skillcapped-downloader",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "Offline browser + bulk downloader for the SkillCapped LoL library. Single-file executable: starts a local web server and opens it in your browser.",
  "module": "src/index.ts",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run src/index.ts --no-open",
    "dev:web": "cd web && vite",
    "build:web": "cd web && vite build && bun ../scripts/embed-web.ts",
    "build:exe": "bun run scripts/build-exe.ts",
    "build": "bun run build:web && bun run build:exe",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "test": "bun test tests/unit",
    "test:e2e": "playwright test",
    "test:live": "LIVE=1 playwright test tests/e2e/live.spec.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.0",
    "class-variance-authority": "^0.7.1",
    "hls.js": "^1.7.3",
    "motion": "^13.4.2",
    "radix-ui": "^1.7.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "latest",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
